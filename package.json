{
  "name": "oriental-history-simulator",
  "private": true,
  "version": "1.6.2",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "play": "npm run build && vite preview --host 127.0.0.1 --open",
    "build": "npm run check:release && tsc -b && vite build",
    "check:release": "vite-node scripts/check-release.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "node scripts/e2e-smoke.mjs",
    "test:update": "node scripts/verify-app-update.mjs",
    "test:audit": "npm run test:audit:v03",
    "test:audit:v01": "vite-node scripts/seed-audit.ts",
    "test:audit:v02": "vite-node scripts/v02-audit.ts",
    "test:audit:v03": "vite-node scripts/v03-audit.ts",
    "test:audit:phase-a": "vite-node scripts/phase-a-audit.ts",
    "test:audit:phase-b": "vite-node scripts/phase-b-audit.ts",
    "test:audit:phase-c": "vite-node scripts/phase-c-audit.ts",
    "test:audit:agency": "vite-node scripts/phase-c-agency-audit.ts",
    "test:audit:agency-continuity": "vite-node scripts/phase-c-agency-continuity-audit.ts",
    "test:audit:agency-intent": "vite-node scripts/phase-c-intent-audit.ts",
    "test:audit:power-narrative": "vite-node scripts/power-narrative-audit.ts",
    "test:audit:local-governance": "vite-node scripts/local-governance-audit.ts",
    "test:audit:architecture": "vite-node scripts/architecture-baseline.ts",
    "test:release": "npm run test:run && npm run test:audit:architecture && npm run build && npm run test:update && npm run test:e2e && npm run test:audit:phase-a && npm run test:audit:phase-b && npm run test:audit:phase-c && npm run test:audit:agency && npm run test:audit:agency-continuity && npm run test:audit:agency-intent && npm run test:audit:power-narrative && npm run test:audit:local-governance && npm run test:audit",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.7.0",
    "playwright": "1.49.1",
    "typescript": "5.7.3",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  }
}
